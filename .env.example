# Copy to .env for local development. Never commit .env.
# In Posit Connect, set the same variables in the app's Vars tab.

DATABRICKS_SERVER_HOSTNAME=adb-0000000000000000.0.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx
# Read-only credential with SELECT on the unrestricted schema only.
# The app never reads the restricted schema (flood thresholds).
DATABRICKS_TOKEN=

# Defaults match the pipeline's config.py.
FGS_CATALOG=prd_dash_lab
FGS_SCHEMA=flood_forecasting_unrestricted

# Must match FGS_GEOMETRY_SOURCE in the pipeline's config.py: risk_areas or aoc.
FGS_GEOMETRY_SOURCE=risk_areas

# Seconds to cache query results across sessions. 0 turns the cache off.
FGS_CACHE_SECONDS=90
